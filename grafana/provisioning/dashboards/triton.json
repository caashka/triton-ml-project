{
  "title": "Triton Inference Monitoring",
  "uid": "triton-ml",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per Second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(nv_inference_request_success{model=\"image_classifier\"}[1m])",
          "legendFormat": "Успешные"
        },
        {
          "expr": "rate(nv_inference_request_failure{model=\"image_classifier\"}[1m])",
          "legendFormat": "Ошибки"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Inference Latency (avg, summary-метрика)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(nv_inference_request_duration_us{model=\"image_classifier\"}[1m]) / rate(nv_inference_request_success{model=\"image_classifier\"}[1m]) / 1000",
          "legendFormat": "Среднее время инференса"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "В Triton 23.11 nv_inference_request_duration_us — накопительный счётчик (µs): среднее = rate(duration)/rate(success). p50/p95/p99 измерены клиентом в нагрузочном тесте"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pending Requests (Queue)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "nv_inference_pending_request_count{model=\"image_classifier\"}",
          "legendFormat": "В очереди"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "nv_inference_request_success{model=\"image_classifier\"}",
          "legendFormat": "Успешные"
        },
        {
          "expr": "nv_inference_request_failure{model=\"image_classifier\"}",
          "legendFormat": "Неуспешные"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue Time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(nv_inference_queue_duration_us{model=\"image_classifier\"}[1m]) / rate(nv_inference_request_success{model=\"image_classifier\"}[1m]) / 1000",
          "legendFormat": "Среднее время в очереди"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "Среднее время ожидания в очереди динамического батчинга"
    }
  ]
}